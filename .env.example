# ── Sitio ──
NEXT_PUBLIC_APP_URL=https://el-origen-two.vercel.app

# ── Panel admin (obligatorio en producción) ──
ADMIN_PASSWORD=
# Recomendado: secreto largo y aleatorio para firmar las sesiones (admin, puerta, miembros) y los enlaces
# de recuperación de contraseña. Si cambia, se cierran todas las sesiones abiertas.
AUTH_SECRET=

# ── Acceso "puerta" (solo escáner de entradas, sin acceso al resto del panel) ──
# Obligatorio en producción. En desarrollo, si se deja vacío, la clave es "puerta-origen".
DOOR_PASSWORD=

# ── Supabase: datos y archivos (ejecutar supabase/orders.sql y luego supabase/v2.sql) ──
# Sin estas claves todo se guarda en memoria (solo para pruebas locales: se pierde al reiniciar).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Correo con las entradas ──
# Opción principal: Gmail SMTP con la cuenta de ventas (ej. ventasorigen@gmail.com).
# GMAIL_APP_PASSWORD es una "contraseña de aplicación" de Google (requiere verificación en 2 pasos),
# NO la contraseña normal de la cuenta. Se puede pegar con o sin espacios.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternativa (solo si Gmail no está configurado): resend.com
RESEND_API_KEY=
# Remitente verificado en Resend, ej. "El Origen <reservas@tudominio.com>"
RESEND_FROM_EMAIL=
# A dónde llegan los avisos de comprobantes nuevos (por defecto experiencethewine22@gmail.com)
ADMIN_NOTIFY_EMAIL=

# ── WhatsApp: bot propio (carpeta whatsapp-bot/) ──
# Clave compartida con el bot. Genere una larga y aleatoria y póngala IGUAL en whatsapp-bot/.env
WHATSAPP_QUEUE_SECRET=

# ── WhatsApp Business Cloud API (Meta) — opcional, tiene prioridad sobre el bot ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Plantilla aprobada por Meta con 4 variables: {{1}} nombre, {{2}} cata, {{3}} fecha y hora, {{4}} enlace
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=es

# ── Solo pruebas locales ──
# EO_DEMO_SEED=1 siembra 2 catas de ejemplo (activas, con fecha futura) cuando NO hay Supabase.
# Nunca activar en producción.
EO_DEMO_SEED=
