# Dirección del sitio publicado (sin barra final)
APP_URL=https://elorigenvzla.com

# Debe ser IGUAL a la variable WHATSAPP_QUEUE_SECRET configurada en Vercel
WHATSAPP_QUEUE_SECRET=

# Panel local del bot: http://localhost:3001
PORT=3001

# Cada cuántos segundos revisa si hay entradas por enviar
POLL_SECONDS=4

# Solo en servidores sin pantalla (Railway): carpeta de la sesión (en un volumen) y número a vincular
# con código en vez de QR (con código de país, sin + ni espacios).
# AUTH_DIR=/data/auth_info
# PAIRING_PHONE=584141074007
